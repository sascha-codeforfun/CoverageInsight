<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CoverageInsight</AssemblyName>
    <RootNamespace>CoverageInsight</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Remove-then-Include: harmless if the SDK already globbed these in as
       Resource items, and adds them if it didn't. Either way, no duplicates. -->
  <ItemGroup>
    <Resource Remove="Assets\app_256.png" />
    <Resource Include="Assets\app_256.png" />
    <None Remove="Assets\app.svg" />
    <None Include="Assets\app.svg" />
  </ItemGroup>

  <!-- No NuGet packages on purpose: this restores and builds offline. -->

</Project>
